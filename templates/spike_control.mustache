{{!
    @template qtype_codeatelier/spike_control

    Renders the CodeAtelier question text and the result control used to validate
    the grading round-trip.

    Context variables required for this template:
    * questiontext string - the rendered question text (already safe HTML)
    * prompt string - the group prompt shown in the fieldset legend
    * options array - the selectable results, each with:
        * name string - the form field name shared by the radio group
        * id string - the unique input id
        * value string - the submitted fraction in [0, 1]
        * label string - the visible label
        * checked bool - whether this option is currently selected
        * readonly bool - whether the control is disabled (review)
    * hasvalidationerror bool - whether to show the validation message
    * validationerror string - the validation message
}}
<div class="qtype_codeatelier qtype_codeatelier_spike">
    <div class="qtext">{{{questiontext}}}</div>
    <fieldset class="ablock">
        <legend class="prompt h6 font-weight-normal">{{prompt}}</legend>
        {{#options}}
        <div class="form-check">
            <input class="form-check-input" type="radio" name="{{name}}" id="{{id}}" value="{{value}}"
                {{#checked}}checked="checked"{{/checked}} {{#readonly}}disabled="disabled"{{/readonly}}>
            <label class="form-check-label" for="{{id}}">{{label}}</label>
        </div>
        {{/options}}
    </fieldset>
    {{#hasvalidationerror}}
    <div class="validationerror">{{validationerror}}</div>
    {{/hasvalidationerror}}
</div>
