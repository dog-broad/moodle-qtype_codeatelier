{{!
    @template qtype_codeatelier/editor_control

    Renders the question text, the code editor (a textarea enhanced by CodeMirror),
    a run/check control, and a results area.

    Context variables required for this template:
    * questiontext string - the rendered question text (already safe HTML)
    * wrapperid string - unique id for the wrapper element
    * answername string - the qt field name for the student's code
    * answerid string - the textarea id
    * answervalue string - the current/submitted code
    * answerlabel string - accessible label for the editor
    * scorename string - the qt field name for the browser-computed score
    * scorevalue string - the current score
    * languagename string - the qt field name for the chosen language
    * languagevalue string - the chosen language code
    * languagechoice bool - whether to show the language picker (more than one allowed, live attempt)
    * languageoptions array - {code, label, selected} per allowed language
    * languagechooselabel string - label for the language picker
    * showlanguageused bool - whether to show which language was used (review of a multi-language question)
    * languageusedlabel string - the "Language used: X" note for review
    * runlabel string - the run button label
    * focuslabel string - the focus-mode toggle button label
    * outputtabslabel string - accessible label for the output/tests tablist
    * practicenote string - a note that this runs in the browser for practice
    * readonly bool - whether the question is being reviewed (no editing/running)
    * hasvalidationerror bool - whether to show the validation message
    * validationerror string - the validation message
    * controlconfig string - JSON config for control.js (read from the data attribute
      rather than passed as AMD init args, which Moodle caps at 1024 chars)
}}
<div class="qtype_codeatelier" id="{{wrapperid}}" data-config="{{controlconfig}}">
    <div class="codeatelier-pane codeatelier-pane-problem" data-role="pane-problem">
        <div class="qtext">{{{questiontext}}}</div>
        <div class="codeatelier-schema" data-role="schema"></div>
        <div class="codeatelier-examples" data-role="examples"></div>
    </div>
    <div class="codeatelier-pane codeatelier-pane-work" data-role="pane-work">
        {{#languagechoice}}
        <div class="codeatelier-langpicker" data-role="langpicker">
            <label class="codeatelier-block-label" for="{{wrapperid}}_language">{{languagechooselabel}}</label>
            <select class="form-select" id="{{wrapperid}}_language" data-role="language-select">
                {{#languageoptions}}
                <option value="{{code}}" {{#selected}}selected="selected"{{/selected}}>{{label}}</option>
                {{/languageoptions}}
            </select>
        </div>
        {{/languagechoice}}
        {{#showlanguageused}}
        <p class="codeatelier-language-used small text-muted" data-role="language-used">{{languageusedlabel}}</p>
        {{/showlanguageused}}
        <div class="codeatelier-editor">
            <label class="visually-hidden" for="{{answerid}}">{{answerlabel}}</label>
            <div class="codeatelier-skeleton" data-role="skeleton" aria-hidden="true">
                <span class="codeatelier-skeleton-label">{{loadingeditor}}</span>
            </div>
            <textarea class="codeatelier-answer" data-role="answer" name="{{answername}}" id="{{answerid}}"
                rows="12" cols="80" spellcheck="false" {{#readonly}}readonly="readonly"{{/readonly}}>{{answervalue}}</textarea>
            <noscript>
                <style>.qtype_codeatelier .codeatelier-answer{display:block}.qtype_codeatelier .codeatelier-skeleton{display:none}</style>
            </noscript>
            {{^readonly}}
            <div class="codeatelier-editor-tools" data-role="editor-tools">
                <label class="visually-hidden" for="{{wrapperid}}_theme">{{themelabel}}</label>
                <select class="form-select form-select-sm codeatelier-theme-select" id="{{wrapperid}}_theme" data-role="editor-theme">
                    <option value="auto">{{themeauto}}</option>
                    <option value="light">{{themelight}}</option>
                    <option value="dark">{{themedark}}</option>
                    <option value="hc">{{themehighcontrast}}</option>
                </select>
                <button type="button" class="btn btn-link btn-sm codeatelier-editor-find" data-role="editor-find">{{findlabel}}</button>
                <button type="button" class="btn btn-link btn-sm codeatelier-editor-format" data-role="editor-format">{{formatlabel}}</button>
                <details class="codeatelier-shortcuts">
                    <summary>{{shortcutstitle}}</summary>
                    <div class="codeatelier-shortcuts-body">{{{shortcutshtml}}}</div>
                </details>
            </div>
            {{/readonly}}
        </div>
        {{#isweb}}
        <div class="codeatelier-preview">
            <span class="codeatelier-block-label">{{previewlabel}}</span>
            <div class="codeatelier-preview-host" data-role="preview"></div>
        </div>
        {{^readonly}}
        {{^isjudge}}
        <div class="codeatelier-actions">
            <button type="button" class="btn btn-primary" data-role="check">{{checklabel}}</button>
            <span class="codeatelier-status" data-role="status" role="status" aria-live="polite"></span>
        </div>
        <p class="codeatelier-practicenote small">{{practicenote}}</p>
        <div class="codeatelier-results" data-role="results" aria-live="polite"></div>
        {{/isjudge}}
        {{#isjudge}}
        <p class="codeatelier-judgenote small">{{judgenote}}</p>
        {{#proctornote}}<p class="codeatelier-proctornote small">{{proctornote}}</p>{{/proctornote}}
        {{/isjudge}}
        {{/readonly}}
        {{/isweb}}
        {{^readonly}}
        {{^isweb}}
        {{^isjudge}}
        <div class="codeatelier-scratch" data-role="scratchwrap" style="display: none;">
            <label class="codeatelier-block-label" data-role="scratchlabel" for="{{answerid}}_scratch"></label>
            <textarea class="codeatelier-scratch-input" data-role="scratch" id="{{answerid}}_scratch"
                rows="2" cols="80" spellcheck="false"></textarea>
        </div>
        <div class="codeatelier-actions">
            <button type="button" class="btn btn-secondary" data-role="run">{{runlabel}}</button>
            <button type="button" class="btn btn-primary" data-role="check">{{checklabel}}</button>
            <button type="button" class="btn btn-secondary" data-role="stop" style="display: none;">{{stoplabel}}</button>
            <span class="codeatelier-status" data-role="status" role="status" aria-live="polite"></span>
            <button type="button" class="btn btn-link codeatelier-focus-toggle" data-role="focus"
                aria-pressed="false">{{focuslabel}}</button>
        </div>
        <p class="codeatelier-practicenote small">{{practicenote}}</p>
        <div class="codeatelier-tabs" role="tablist" aria-label="{{outputtabslabel}}">
            <button type="button" class="codeatelier-tab" role="tab" id="{{wrapperid}}_tab_console"
                aria-controls="{{wrapperid}}_panel_console" aria-selected="false" tabindex="-1"
                data-role="tab" data-tab="console">{{consolelabel}}</button>
            <button type="button" class="codeatelier-tab" role="tab" id="{{wrapperid}}_tab_tests"
                aria-controls="{{wrapperid}}_panel_tests" aria-selected="true"
                data-role="tab" data-tab="tests">{{testslabel}}</button>
        </div>
        <p class="codeatelier-output-empty" data-role="output-empty">{{outputempty}}</p>
        {{/isjudge}}
        {{#isjudge}}
        <p class="codeatelier-judgenote small">{{judgenote}}</p>
        {{#canrunexamples}}
        <div class="codeatelier-actions">
            <button type="button" class="btn btn-secondary" data-role="runexamples">{{runexampleslabel}}</button>
        </div>
        <div class="codeatelier-runresults" data-role="runresults" aria-live="polite"></div>
        {{/canrunexamples}}
        {{#canrunscratch}}
        <div class="codeatelier-scratch-judge" data-role="scratchwrap">
            <label class="codeatelier-block-label" for="{{answerid}}_jscratch">{{scratchlabel}}</label>
            <textarea class="codeatelier-scratch-input" data-role="scratchinput" id="{{answerid}}_jscratch"
                rows="3" spellcheck="false">{{scratchdefault}}</textarea>
            <div class="codeatelier-actions">
                <button type="button" class="btn btn-secondary" data-role="runscratch">{{runlabel}}</button>
            </div>
            <div class="codeatelier-scratchoutput" data-role="scratchoutput" aria-live="polite"></div>
        </div>
        {{/canrunscratch}}
        {{#proctornote}}<p class="codeatelier-proctornote small">{{proctornote}}</p>{{/proctornote}}
        {{/isjudge}}
        {{/isweb}}
        {{/readonly}}
        <input type="hidden" data-role="score" name="{{scorename}}" value="{{scorevalue}}">
        <input type="hidden" data-role="language" name="{{languagename}}" value="{{languagevalue}}">
        {{^isweb}}
        {{^isjudge}}
        <div class="codeatelier-console" id="{{wrapperid}}_panel_console" role="tabpanel"
            aria-labelledby="{{wrapperid}}_tab_console" tabindex="0"
            data-role="console" data-tabpanel="console" aria-live="polite"></div>
        <div class="codeatelier-results" id="{{wrapperid}}_panel_tests" role="tabpanel"
            aria-labelledby="{{wrapperid}}_tab_tests" tabindex="0"
            data-role="results" data-tabpanel="tests" aria-live="polite"></div>
        {{/isjudge}}
        {{/isweb}}
        {{#isjudge}}
        <div class="codeatelier-judge-results" data-role="judge-results">{{{judgereviewhtml}}}</div>
        {{/isjudge}}
        {{#hasvalidationerror}}
        <div class="validationerror">{{validationerror}}</div>
        {{/hasvalidationerror}}
    </div>
</div>
