{{!
    @template qtype_codeatelier/report_quiz

    The per-quiz overview of CodeAtelier questions.
}}
<div class="qtype_codeatelier-report">
    {{^hasquestions}}
        <div class="alert alert-info">{{#str}}report_quiz_noquestions, qtype_codeatelier{{/str}}</div>
    {{/hasquestions}}
    {{#hasquestions}}
    <table class="table table-sm">
        <thead><tr>
            <th>{{#str}}report_question, qtype_codeatelier{{/str}}</th>
            <th>{{#str}}tier, qtype_codeatelier{{/str}}</th>
            <th class="text-right">{{#str}}report_attempts, qtype_codeatelier{{/str}}</th>
            <th class="text-right">{{#str}}report_needsgrading, qtype_codeatelier{{/str}}</th>
            <th class="text-right">{{#str}}report_meanscore, qtype_codeatelier{{/str}}</th>
        </tr></thead>
        <tbody>
        {{#questions}}
        <tr>
            <td><a href="{{reporturl}}">{{name}}</a></td>
            <td><span class="badge badge-secondary">{{tierlabel}}</span></td>
            <td class="text-right">{{totalattempts}}</td>
            <td class="text-right {{#hasneedsgrading}}text-warning{{/hasneedsgrading}}">{{needsgrading}}</td>
            <td class="text-right">{{#hasmean}}{{meanscorepct}}%{{/hasmean}}{{^hasmean}}&mdash;{{/hasmean}}</td>
        </tr>
        {{/questions}}
        </tbody>
    </table>
    {{/hasquestions}}
</div>
